generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  OWNER
  STAFF
}

model Admin {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  /// How the admin is called in the app ("Olá, Ana") and shown to the team.
  name         String      @default("")
  /// OWNER sees and manages everything, the team included; STAFF only what `permissions` lists (lib/permissions).
  role         AdminRole   @default(OWNER)
  permissions  String[]    @default([])
  /// A new booking request pushes a notification to this admin's iPhones.
  notifyNewBookings Boolean @default(true)
  avatar          Bytes?
  avatarType      String?
  avatarUpdatedAt DateTime?
  createdAt    DateTime    @default(now())
  pushTokens   PushToken[]
  broadcasts   Broadcast[]
}

model PushToken {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token     String   @unique
  // Notifications sent to this iPhone that it has not opened yet: shown on the app icon, zeroed when the app opens.
  badge     Int      @default(0)
  createdAt DateTime @default(now())
}

model Service {
  id            String    @id @default(cuid())
  name          String    @unique
  description   String
  durationLabel String
  priceCents    Int
  /// Prices by length and/or parting: { lengths: string[], partings: string[], prices: { "length|parting": cents } }.
  /// When set, the customer picks the options and `priceCents` is the "a partir de" (lowest) price.
  pricing       Json?
  /// Hidden from booking (kept for the bookings already made with it).
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  bookings      Booking[]
  images        ServiceImage[]
  favourites    FavouriteService[]
  promotions    Promotion[]
}

enum SlotStatus {
  OPEN
  PENDING
  BOOKED
}

model AvailabilitySlot {
  id        String     @id @default(cuid())
  startsAt  DateTime   @unique
  status    SlotStatus @default(OPEN)
  createdAt DateTime   @default(now())
  bookings  Booking[]
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String
  passwordHash String
  // Private notes the business keeps about this client (never shown to the client).
  adminNotes   String        @default("")
  // How the 48 h reminder reaches this customer besides the app notification: 'EMAIL' or 'PHONE' (a text message).
  reminderChannel String     @default("EMAIL")
  // Optional profile photo (a small square JPEG the app prepares); shown in testimonials only when the
  // customer opts in on that testimonial.
  avatar        Bytes?
  avatarType    String?
  avatarUpdatedAt DateTime?
  pushTokens   CustomerPushToken[]
  notifications CustomerNotification[]
  createdAt    DateTime      @default(now())
  bookings     Booking[]
  testimonials Testimonial[]
  favourites   FavouriteService[]
  photos       CustomerPhoto[]
}

model PendingRegistration {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String
  passwordHash String
  code         String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Booking {
  id            String           @id @default(cuid())
  slotId        String
  slot          AvailabilitySlot @relation(fields: [slotId], references: [id])
  serviceId     String
  service       Service          @relation(fields: [serviceId], references: [id])
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  customerName  String
  customerPhone String
  notes         String?
  /// The options chosen for this booking, e.g. "Longa · Finas", and the price they came to.
  optionLabel   String?
  priceCents    Int?
  /// The braiding-hair colour chosen, by its code (lib/braid-colors), e.g. "27".
  colorCode     String?
  status        BookingStatus    @default(PENDING)
  reminderSentAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model Testimonial {
  id         String            @id @default(cuid())
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  content    String
  // The customer agreed to show their profile photo next to this testimonial.
  showPhoto  Boolean           @default(false)
  status     TestimonialStatus @default(PENDING)
  createdAt  DateTime          @default(now())
}


// Single row (id "main"): contact details and policies the business edits from the admin app.
model BusinessSettings {
  id                 String   @id @default("main")
  whatsappNumber     String   @default("")
  phone              String   @default("")
  address            String   @default("")
  mapUrl             String   @default("")
  openingHours       Json     @default("[]")
  cancellationPolicy String   @default("")
  updatedAt          DateTime @updatedAt
}

// The admin Início's monthly revenue goal. Its own table, so the public business settings never depend on it.
model DashboardGoal {
  id           String   @id @default("main")
  monthlyCents Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// iPhone push tokens of the customer app (one customer can have several devices).
model CustomerPushToken {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String   @unique
  // Notifications sent to this iPhone that it has not opened yet (see PushToken.badge).
  badge      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// Photos of a hairstyle, shown to customers before they pick it. Stored in the database (small, resized
// by the admin app before upload); position 0 is the cover.
model ServiceImage {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  data        Bytes
  contentType String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([serviceId, position])
}

enum PortfolioKind {
  IMAGE
  VIDEO
}

// Photos and short videos of the studio's work, managed by the admin and shown in the customer app.
// Stored in the database; position 0 is shown first.
model PortfolioItem {
  id          String        @id @default(cuid())
  kind        PortfolioKind
  contentType String
  data        Bytes
  position    Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([position])
}

/// Every notification sent to a customer (booking confirmed, declined, cancelled, reminder…), kept so the website
/// can list them under its bell for customers who don't use the app.
model CustomerNotification {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String
  body       String
  bookingId  String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
}

/// A hairstyle a customer marked as a favourite (the heart), to find it and book it again.
model FavouriteService {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, serviceId])
}

/// Photos the business keeps of a client's hair (the finished style, the hair before…), private to the admin.
model CustomerPhoto {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  data        Bytes
  contentType String
  caption     String   @default("")
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
}

/// Days the studio is closed (holidays, days off): no times can be opened on them. Dates are Lisbon-local
/// "YYYY-MM-DD", both ends included.
model ClosedPeriod {
  id        String   @id @default(cuid())
  startDate String
  endDate   String
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@index([endDate])
}

/// A discount on one hairstyle (or every one, when serviceId is null) between two moments. The customer sees and
/// books the discounted price while it runs.
model Promotion {
  id         String   @id @default(cuid())
  title      String
  percentOff Int
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([endsAt])
}

/// A message the business sent to its clients from the admin app (push + the website's bell).
model Broadcast {
  id             String   @id @default(cuid())
  title          String
  body           String
  /// "ALL" or "SELECTED".
  audience       String
  recipientCount Int
  adminId        String?
  admin          Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
