generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  pushTokens   PushToken[]
}

model PushToken {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id])
  token     String   @unique
  createdAt DateTime @default(now())
}

model Service {
  id            String    @id @default(cuid())
  name          String    @unique
  description   String
  durationLabel String
  priceCents    Int
  createdAt     DateTime  @default(now())
  bookings      Booking[]
}

enum SlotStatus {
  OPEN
  PENDING
  BOOKED
}

model AvailabilitySlot {
  id        String     @id @default(cuid())
  startsAt  DateTime   @unique
  status    SlotStatus @default(OPEN)
  createdAt DateTime   @default(now())
  bookings  Booking[]
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String
  passwordHash String
  // Private notes the business keeps about this client (never shown to the client).
  adminNotes   String        @default("")
  pushTokens   CustomerPushToken[]
  createdAt    DateTime      @default(now())
  bookings     Booking[]
  testimonials Testimonial[]
}

model PendingRegistration {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String
  passwordHash String
  code         String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Booking {
  id            String           @id @default(cuid())
  slotId        String
  slot          AvailabilitySlot @relation(fields: [slotId], references: [id])
  serviceId     String
  service       Service          @relation(fields: [serviceId], references: [id])
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  customerName  String
  customerPhone String
  notes         String?
  status        BookingStatus    @default(PENDING)
  reminderSentAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model Testimonial {
  id         String            @id @default(cuid())
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  content    String
  status     TestimonialStatus @default(PENDING)
  createdAt  DateTime          @default(now())
}


// Single row (id "main"): contact details and policies the business edits from the admin app.
model BusinessSettings {
  id                 String   @id @default("main")
  whatsappNumber     String   @default("")
  phone              String   @default("")
  address            String   @default("")
  mapUrl             String   @default("")
  openingHours       Json     @default("[]")
  cancellationPolicy String   @default("")
  updatedAt          DateTime @updatedAt
}

// iPhone push tokens of the customer app (one customer can have several devices).
model CustomerPushToken {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String   @unique
  createdAt  DateTime @default(now())

  @@index([customerId])
}
